<?xml version="1.0" encoding="utf-8"?>
<!--
    Permissions and features of the Bluetooth discovery, handshake channel and capability detection (architecture §11,
    WP7a/WP7b). They merge into the app manifest; ui/android declares the same runtime permissions for its just-in-time
    requests, and later WP7 packages add the Wi-Fi Direct, hotspot and foreground-service ones with their code.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        Scanning for drop beacons only. neverForLocation: the app never derives location from scan results, so no
        location permission is needed on Android 12+. The system then filters out well-known location beacons
        (iBeacon, Eddystone) from our results, which drop does not use.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <!-- The beacon (AdvertisingSet, legacy and extended). -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <!-- GATT client and server, LE L2CAP channels and RFCOMM sockets of the handshake and head-start channel. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Capability detection: Wi-Fi bands and standards, the connected network and its link properties. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- The app still installs without Bluetooth (QR code and LAN paths); capability detection reports what is there. -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.wifi"
        android:required="false" />

    <!--
        WP7e/f: the transfer service (architecture §10.1, §11; spec change S9). One foreground service owns the radios and
        the engine: type connectedDevice for the radio session (background visibility, incoming Offers), dataSync added
        while a transfer runs. CHANGE_WIFI_MULTICAST_STATE is the MulticastLock of the browser page's mDNS responder
        and also meets Android 14's connectedDevice prerequisite without a runtime grant. INTERNET: sockets (LAN links,
        the browser page); nothing leaves the device's local networks.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
        WP7c/d: Wi-Fi Direct groups, the local-only hotspot, WifiNetworkSpecifier joins, LAN sockets and NSD
        (architecture §8, §11). The runtime ones match ui/android's declarations exactly, so the manifests merge.
        INTERNET (TCP streams on the link networks) and CHANGE_WIFI_MULTICAST_STATE (mDNS reception for NsdManager
        before the Tiramisu SDK extension 7, and the drop.local responder) are declared once, above.
    -->
    <!-- createGroup, connect, removeGroup, startLocalOnlyHotspot and the multicast lock. -->
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <!-- ConnectivityManager.requestNetwork with a WifiNetworkSpecifier (the hotspot and legacy group joins). -->
    <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE" />
    <!-- Wi-Fi Direct and the local-only hotspot on Android 13+, without location. -->
    <uses-permission
        xmlns:tools="http://schemas.android.com/tools"
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="tiramisu" />
    <!-- Android 12 only: Wi-Fi Direct and the local-only hotspot need fine location, asked together with coarse. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="32" />
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION"
        android:maxSdkVersion="32" />
    <!-- Android 17, target 37: LAN sockets and NsdManager need the local network permission. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <uses-feature
        android:name="android.hardware.wifi.direct"
        android:required="false" />

    <application>
        <!-- Not exported: only this app starts and binds it (notification actions go through PendingIntents). -->
        <service
            android:name=".service.TransferService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice|dataSync" />
    </application>
</manifest>
