<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing leaves the device in cloud backups or device-to-device transfer: identity keys and pairings belong to
    this device (architecture §13), and everything else is local-only history (PRD privacy).
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
